{
  "text": {
    "base_url": "https://apihub.agnes-ai.com/v1",
    "api_key_env": "AGNES_API_KEY",
    "model": "agnes-2.5-flash",
    "timeout": 180,
    "retries": 2,
    "extra": {"temperature": 0.65, "max_tokens": 12000}
  },
  "image": {
    "provider": "agnes",
    "base_url": "https://apihub.agnes-ai.com/v1",
    "api_key_env": "AGNES_API_KEY",
    "model": "agnes-image-2.5-flash",
    "size": "1K",
    "supports_reference": false,
    "reference_field": "extra_body.image",
    "timeout": 240,
    "overall_timeout": 360,
    "retries": 2,
    "min_interval_seconds": 60,
    "rate_limit_file": "runs/.cache/agnes-rate-limit.json",
    "request_log_file": "runs/.cache/agnes-requests.jsonl",
    "extra": {"ratio": "4:3", "extra_body": {"response_format": "b64_json"}}
  },
  "render": {
    "style": "chibi",
    "font_path": "",
    "accent": "#d84138",
    "paper": "#fffaf0",
    "platform": "xiaohongshu",
    "panels_per_page": 2
  },
  "promotion": {
    "destination": "知乎",
    "cta_template": "去{destination}搜索「{keyword}」\n继续阅读后续故事",
    "disclosure": "AI辅助创作 · 小说情节演绎",
    "commercial_disclosure": "本内容含推广；有效转化可能获得佣金"
  },
  "network": {"trust_env": true}
}
